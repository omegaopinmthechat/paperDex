# Sepolia RPC endpoint
SEPOLIA_RPC_URL=https://your-sepolia-rpc-url

# Private key of the wallet that deploys/administers the contracts
# This wallet needs Sepolia ETH
DEPLOYER_PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY

# Address of the wallet your Express backend will use to pay gas
RELAYER_ADDRESS=0xYOUR_RELAYER_WALLET_ADDRESS

# Address corresponding to the backend key used to sign price/trade quotes
QUOTE_SIGNER_ADDRESS=0xYOUR_QUOTE_SIGNER_ADDRESS